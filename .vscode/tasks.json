	"inputs": [
		{
			"id": "sourceDirectory",
			"description": "Path to directory containing source images",
			"default": "images/originals",
			"type": "promptString"
		},
		{
			"id": "dataFile",
			"description": "Path to the image file or directory containing images(e.g. images/processed/24px)",
			"default": "images/processed/24px",
			"type": "promptString"
		},
		{
			"id": "scaleFactor",
			"description": "Scale factor for the image",
			"default": "5",
			"type": "promptString"
		},
		{
			"id": "maxWidth",
			"description": "Maximum width of composite image in pixels",
			"default": "1200",
			"type": "promptString"
		},
		{
			"id": "contrast",
			"description": "Contrast multiplier (1.0 = no change, >1.0 = more contrast)",
			"default": "1.2",
			"type": "promptString"
		},
		{
			"id": "saturation",
			"description": "Saturation multiplier (1.0 = no change, >1.0 = more saturated)",
			"default": "1.3",
			"type": "promptString"
		},
		{
			"id": "brightness",
			"description": "Brightness multiplier (1.0 = no change, >1.0 = brighter)",
			"default": "1.05",
			"type": "promptString"
		},
		{
			"id": "sharpness",
			"description": "Sharpness multiplier (1.0 = no change, >1.0 = sharper)",
			"default": "1.1",
			"type": "promptString"
		},
		{
			"id": "gamma",
			"description": "Gamma correction (<1.0 brightens mid-tones, >1.0 darkens them)",
			"default": "0.85",
			"type": "promptString"
		},
		{
			"id": "unsharpRadius",
			"description": "Unsharp mask radius (blur radius for edge detection)",
			"default": "0.8",
			"type": "promptString"
		},
		{
			"id": "unsharpPercent",
			"description": "Unsharp mask strength percentage (100 = normal, >100 = stronger)",
			"default": "120",
			"type": "promptString"
		},
		{
			"id": "unsharpThreshold",
			"description": "Unsharp mask threshold (minimum difference to apply sharpening)",
			"default": "2",
			"type": "promptString"
		},
		{
			"id": "inputDirectory",
			"description": "Input directory containing PNG images to encode",
			"default": "images/",
			"type": "promptString"
		}
	]
}